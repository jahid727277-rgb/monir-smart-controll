#include <ESP8266WiFi.h>
#include <WiFiManager.h>
#include <FirebaseESP8266.h>
#include <time.h>

// ---------- Firebase ----------
#define FIREBASE_HOST "https://monir-smart-control-default-rtdb.firebaseio.com"
#define FIREBASE_SECRET "gTiMlZxe9Sv5H1Yo6pz85ZJQNIchwWIqjThzDAX2"

// ---------- Hardware ----------
#define ALARM_PIN D1   // Relay / Buzzer

FirebaseData fbdo;
FirebaseConfig config;
FirebaseAuth auth;

// ---------- Alarm control ----------
bool alarmOn = false;
unsigned long alarmStart = 0;
unsigned long alarmDurationMs = 0;

unsigned long lastCheck = 0;
const unsigned long CHECK_INTERVAL = 1000; // 1 second

int lockedMinute = -1;

// ---------- Time parser (12H → 24H) ----------
void parseTime(String t, int &h, int &m) {
  int sp = t.indexOf(' ');
  if (sp == -1) return;

  String timePart = t.substring(0, sp);
  String ampm = t.substring(sp + 1);

  int c = timePart.indexOf(':');
  if (c == -1) return;

  h = timePart.substring(0, c).toInt();
  m = timePart.substring(c + 1).toInt();

  if (ampm == "PM" && h != 12) h += 12;
  if (ampm == "AM" && h == 12) h = 0;
}

// ---------- Setup ----------
void setup() {
  Serial.begin(115200);
  delay(100);

  pinMode(ALARM_PIN, OUTPUT);
  digitalWrite(ALARM_PIN, LOW);

  // ---------- WiFi Manager ----------
  WiFiManager wm;
  wm.setConfigPortalTimeout(180); // 3 মিনিট

  if (!wm.autoConnect("Sensotik-Setup")) {
    Serial.println("❌ WiFi Failed! Restarting...");
    ESP.restart();
  }

  // ✅ WiFi কানেক্ট হলে Setup AP পুরোপুরি বন্ধ
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);

  Serial.println("✅ WiFi Connected");
  Serial.print("📶 Connected SSID: ");
  Serial.println(WiFi.SSID());

  // ---------- Firebase ----------
  config.database_url = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_SECRET;
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  // ---------- Time (Bangladesh GMT+6) ----------
  configTime(6 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  while (time(nullptr) < 10000) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n⏰ Time Synced");

  Serial.println("🚨 Alarm system READY");
}

// ---------- Loop ----------
void loop() {

  // ---------- Alarm OFF after duration ----------
  if (alarmOn && millis() - alarmStart >= alarmDurationMs) {
    digitalWrite(ALARM_PIN, LOW);
    alarmOn = false;
    lockedMinute = -1;
    Serial.println("🔕 Alarm OFF");
  }

  // ---------- 1 second interval ----------
  if (millis() - lastCheck < CHECK_INTERVAL) return;
  lastCheck = millis();

  // 🔒 অ্যালার্ম বাজা অবস্থায় Firebase চেক বন্ধ
  if (alarmOn) return;

  if (!Firebase.ready()) return;

  time_t now = time(nullptr);
  struct tm *t = localtime(&now);

  int curH = t->tm_hour;
  int curM = t->tm_min;
  int today = t->tm_wday; // 0 = Sunday

  // একই মিনিটে আবার ট্রিগার বন্ধ
  if (curM == lockedMinute) return;

  // ---------- Read alarms ----------
  if (!Firebase.getJSON(fbdo, "/alarms")) {
    Serial.println("⚠ Firebase read failed");
    return;
  }

  FirebaseJson alarms = fbdo.jsonObject();
  size_t count = alarms.iteratorBegin();

  for (size_t i = 0; i < count; i++) {

    int type;
    String key, raw;
    alarms.iteratorGet(i, type, key, raw);

    FirebaseJson alarm;
    alarm.setJsonData(raw);
    FirebaseJsonData d;

    // ---------- Active ----------
    alarm.get(d, "active");
    if (!d.success || !d.to<bool>()) continue;

    // ---------- Time ----------
    alarm.get(d, "time");
    if (!d.success) continue;

    int ah = -1, am = -1;
    parseTime(d.to<String>(), ah, am);
    if (ah < 0 || am < 0) continue;

    // ---------- Duration ----------
    alarm.get(d, "duration");
    if (!d.success) continue;
    unsigned long thisDuration = d.to<int>() * 1000UL;

    // ---------- Days ----------
    alarm.get(d, "days");
    if (!d.success) continue;

    FirebaseJsonArray daysArr;
    daysArr.setJsonArrayData(d.to<String>());

    bool dayMatch = false;
    for (int x = 0; x < daysArr.size(); x++) {
      FirebaseJsonData v;
      daysArr.get(v, x);
      if (v.to<int>() == today) {
        dayMatch = true;
        break;
      }
    }
    if (!dayMatch) continue;

    // ---------- FINAL MATCH ----------
    if (ah == curH && am == curM) {
      digitalWrite(ALARM_PIN, HIGH);
      alarmOn = true;
      alarmStart = millis();
      alarmDurationMs = thisDuration;
      lockedMinute = curM;

      Serial.print("🔔 Alarm ON for ");
      Serial.print(thisDuration / 1000);
      Serial.println(" seconds");
      break;
    }
  }

  alarms.iteratorEnd();
}
